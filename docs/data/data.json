      {
       "id": "data-stats-q1",
       "type": "single",
       "question_en": "What does the mean describe in a dataset?",
       "question_ar": "ماذا يصف المتوسط الحسابي في مجموعة بيانات؟",
       "options": [
        {
         "id": "a",
         "en": "The arithmetic average",
         "ar": "المتوسط الحسابي"
        },
        {
         "id": "b",
         "en": "The largest value only",
         "ar": "أكبر قيمة فقط"
        },
        {
         "id": "c",
         "en": "The number of columns",
         "ar": "عدد الأعمدة"
        }
       ],
       "answer": [
        "a"
       ],
       "explanation_en": "The mean is the sum of values divided by their count.",
       "explanation_ar": "المتوسط هو مجموع القيم مقسومًا على عددها."
      },
      {
       "id": "data-stats-q2",
       "type": "single",
       "question_en": "Why is it useful to inspect the distribution of data?",
       "question_ar": "لماذا من المفيد فحص توزيع البيانات؟",
       "options": [
        {
         "id": "a",
         "en": "To understand spread and unusual values",
         "ar": "لفهم التشتت والقيم غير المعتادة"
        },
        {
         "id": "b",
         "en": "To rename every column",
         "ar": "لإعادة تسمية كل عمود"
        },
        {
         "id": "c",
         "en": "To remove the need for validation",
         "ar": "لإلغاء الحاجة إلى التحقق"
        }
       ],
       "answer": [
        "a"
       ],
       "explanation_en": "Distribution reveals spread, skew, clusters, and possible outliers.",
       "explanation_ar": "يكشف التوزيع التشتت والانحراف والتجمعات والقيم الشاذة المحتملة."
      }
